# Database
DB_PATH=database/zero-trust.db

# JWT Secrets (generate strong random values)
JWT_SECRET=your-jwt-secret-change-this
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-this
JWT_SERVICE_SECRET=your-jwt-service-secret-change-this

# Gateway Secret (shared between gateway and services)
GATEWAY_SECRET=your-gateway-secret-change-this

# Service Client Secrets
NILAI_SERVICE_SECRET=your-nilai-service-secret-change-this
TRANSKRIP_SERVICE_SECRET=your-transkrip-service-secret-change-this

# Service Client IDs (optional, defaults provided)
# NILAI_SERVICE_CLIENT_ID=nilai-service
# TRANSKRIP_SERVICE_CLIENT_ID=transkrip-service

# Bcrypt rounds
BCRYPT_ROUNDS=10

# Token Expiry
ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_DAYS=1
SERVICE_TOKEN_MINUTES=5

# Time-based Access Control
ALLOWED_HOURS_START=07:00
ALLOWED_HOURS_END=21:00
